generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuoteRequest {
  id            Int      @id @default(autoincrement())
  name          String
  organization  String?
  email         String
  phone         String
  category      String
  requirement   String
  quantity      Int

  status        String   @default("OPEN")
  isPublished   Boolean  @default(false)

  createdAt     DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("VENDOR")
  createdAt DateTime @default(now())

  vendor Vendor?
}


model Vendor {
  id            Int      @id @default(autoincrement())
  companyName   String
  email         String   @unique
  phone         String
  gstNumber     String?
  address       String?
  category      String?
  website       String?
  description   String?

  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
}