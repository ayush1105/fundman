generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuoteRequest {
  id           Int      @id @default(autoincrement()) 
  name         String
  organization String
  email        String
  phone        String
  category     String
  requirement  String
  quantity     String?
  status       String   @default("PENDING")  // 👈 ADD THIS
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}